# --- Site ---
SITE_URL=http://localhost:3000
SITE_NAME=Freshpet
MAILFROM=info@freshpet.in
# 1 = production integrations (WhatsApp OTP, FCM push, SMTP); 0 = log to console instead
PRODUCTION=0
DEBUG=1
SECRET_KEY=change-me-to-a-long-random-string

# --- Database (MySQL / MariaDB) ---
# Data lives in MongoDB. (DB_* below are only needed for scripts/import-sql + migrate-to-mongo, i.e. to load freshpet.sql once)
DB_ENGINE=mongo
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB=freshpet
DB_HOST=localhost
DB_PORT=3306
DB_NAME=freshpet
DB_USERNAME=root
DB_PASSWORD=

# --- Integrations (leave empty to disable) ---
AI_URL=
AI_SERVER_KEY=
WHATSAPP_KEY=
MSG91_KEY=
RECAPTCHA_KEY=
# Path to the Firebase service-account JSON (keep it OUTSIDE the repo / public folder)
FIREBASE_SERVICE_ACCOUNT=
# SMTP for email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Secret for the hourly cron endpoint: GET /api/cron/hourly?key=<CRON_KEY> (call at minute 15 of every hour)
CRON_KEY=
# Path to Chrome/Chromium/Edge for PDF generation (letters, COA, invoices)
CHROME_PATH=

# Testing aid: show the OTP on the login screen. Defaults to on when PRODUCTION=0. Set SHOW_OTP=0 before going live.
SHOW_OTP=1

# Passkey login (off = OTP only). Set 1 to enable.
PASSKEYS=0
